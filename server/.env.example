# MongoDB connection string
MONGO_URI=

# Long random string used to sign admin sessions (required)
JWT_SECRET=
# Admin session lifetime (optional, default 1d)
JWT_EXPIRES_IN=1d

# Admin account, created on first start. Changing ADMIN_PASSWORD
# later resets the password once on the next start.
ADMIN_EMAIL=admin@indilens.com
ADMIN_PASSWORD=
ADMIN_NAME=Indilens Admin

# Extra allowed CORS origins, comma separated (optional)
CORS_ORIGINS=

PORT=5000
